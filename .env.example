# Sarvam AI — https://dashboard.sarvam.ai (API Keys)
SARVAM_API_KEY=

# Flagsmith — server-side environment key (Environment settings -> Keys -> Server-side)
FLAGSMITH_SERVER_KEY=

# Only needed to run scripts/setup-flagsmith.mjs (Organisation settings -> API Keys)
FLAGSMITH_ADMIN_KEY=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENV_IDS=

# Optional: Upstash Redis (Vercel Marketplace). Without it Bolo keeps data in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
